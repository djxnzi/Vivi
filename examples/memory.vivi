// Memory by Xansidev - github.com/XansiOnGit
// I made this to just test some things with memory.

#import "core/memory"

p := mmap(4096)
println(p)          // big boi number not null
poke(p, 42)
println(peek(p))   // 42

a := malloc(100)
b := malloc(100)
println(b - a)      // 128

q := malloc(16)
poke(q, 7)
poke(q + 15, 9)
println(peek(q), peek(q + 15))   // 7 9

src := malloc(8)
dst := malloc(8)
poke(src, 1)
poke(src + 1, 2)
memcpy(dst, src, 2)
println(peek(dst), peek(dst + 1))   // 1 2 i thunk

//checks for chunk-refill path

for i := 0; i < 20000; i++ { malloc(100) }
println("Yup, I'm working!")
println(malloc(5000000) != null)