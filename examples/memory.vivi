p := _mmap(4096)
println(p)          // big boi number not null
_poke(p, 42)
println(_peek(p))   // 42

a := malloc(100)
b := malloc(100)
println(b - a)      // 128

q := malloc(16)
_poke(q, 7)
_poke(q + 15, 9)
println(_peek(q), _peek(q + 15))   // 7 9

   src := malloc(8)
   dst := malloc(8)
   _poke(src, 1)
   _poke(src + 1, 2)
   memcpy(dst, src, 2)
   println(_peek(dst), _peek(dst + 1))   // 1 2 i thunk

    //checks for chunk-refill path

      for i := 0; i < 20000; i++ { malloc(100) }
