#import "Strings"
#import "Sys"
#import "Io"

// helper thing to make output readable
check := (label, condition) {
    if condition {
        print("[OK] " ~ label ~ "\n")
    } else {
        print("[FAIL] " ~ label ~ "\n")
    }
}

print("Testing vivi sys core library.\n\n")

// get_cwd and abs_dir, expand_path

print("Paths\n")
cwd := get_cwd()
print("get_cwd(): " ~ cwd ~ "\n")

abs1 := abs_dir(".")
print("abs_dir(\".\"): " ~ abs1 ~ "\n")
check("abs_dir resolves relative to cwd", abs1 == cwd)

abs2 := abs_dir("foo/../bar/./baz")
print("abs_dir(\"foo/../bar/./baz\"): " ~ abs2 ~ "\n")
check("abs_dir collapses .. and .", abs2 == cwd ~ "/bar/baz")

expanded := expand_path("~/Documents")
print("expand_path(\"~/Documents\"): " ~ expanded ~ "\n")
check("expand_path starts with /", has_prefix(expanded, "/"))

// is_dir and list_dir

print("\n--- Filesystem ---\n")
check("is_dir('/tmp')", is_dir("/tmp"))
check("!is_dir('/etc/passwd')", !is_dir("/etc/passwd"))

dirs := list_dir("/tmp")
if dirs != null {
    print("list_dir('/tmp') found " ~ string(dirs.len) ~ " entries.\n")
    check("list_dir works", dirs.len > 0)
} else {
    print("[FAIL] list_dir('/tmp') returned null\n")
}

// update_size and term_size & ioctl

print("\n--- Terminal Size ---\n")
sz := update_size()
print("update_size() -> Cols: " ~ string(sz[0]) ~ ", Rows: " ~ string(sz[1]) ~ "\n")
check("cols > 0", sz[0] > 0)

sz2 := term_size()
check("term_size() matches update_size()", sz2[0] == sz[0] and sz2[1] == sz[1])

// ioctl test (just checking it returns a valid int, it might fail on non-tty)
res := ioctl(1, TIOCGWINSZ, _wbuf)
print("ioctl(1, TIOCGWINSZ) returned: " ~ string(res) ~ "\n")


// termios and tty_is testing

print("\nTermios (fun stuff :3\n")
is_tty := tty_is()
print("tty_is(): " ~ string(is_tty) ~ "\n")

// I barely know anymore.
term_buf := malloc(64)
if termios_get(0, term_buf) >= 0 {
    print("termios_get() succeeded\n")
} else {
    print("termios_get() failed (maybe not a tty?)\n")
}

// goated function for TUI apps.
print("\nSIGWINCH\n")
init_ok := sigwinch_init()
if init_ok {
    print("sigwinch_init() -> OK\n")
    pending := sigwinch_poll()
    print("sigwinch_poll() -> " ~ string(pending) ~ "\n")
    sigwinch_close()
    print("sigwinch_close() -> OK\n")
} else {
    print("[FAIL] sigwinch_init()\n")
}

print("\nSys Execution\n")

res_cap := capture("echo -n 'hello capture'")
print("capture() code: " ~ string(res_cap[0]) ~ ", out: " ~ res_cap[1] ~ "\n")
check("capture output", res_cap[1] == "hello capture")

res_feed := feed("cat", "hello feed")
print("feed() code: " ~ string(res_feed) ~ "\n")

res_pipe := pipe("echo hello pipe", "grep pipe")
print("pipe() code: " ~ string(res_pipe) ~ "\n")

res_redir := redirect("echo redirect_test", "/tmp/vivi_test_redir.txt")
print("redirect() code: " ~ string(res_redir) ~ "\n")
if file_exists("/tmp/vivi_test_redir.txt") {
    print("redirect created file successfully\n")
}

res_run := run("true")
print("run() code: " ~ string(res_run) ~ "\n")

print("\nfinished\n")