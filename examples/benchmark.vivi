#import "Math"

// each work function takes a size and returns how many "operations" it did
bench := (string name, n, work) {
    t0 := timestamp()
    ops := work(n)
    secs := timestamp() - t0
    rate := secs > 0 ? ops / secs : 0
    println(name, "| ops:", ops, "| secs:", secs, "| ops/sec:", rate)
    return secs
}

fib := (n) {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

println("--- vivi bench ---")
all := 0.0

all += bench("loop      ", 200000, (n) {
    total := 0
    for i := 0; i < n; i++ { total += i }
    return n
})

all += bench("calls     ", 22, (n) {
    fib(n)
    // number of calls fib(n) makes
    a := 1
    b := 1
    for i := 2; i <= n; i++ {
        c := 1 + a + b
        a = b
        b = c
    }
    return b
})

all += bench("float     ", 100000, (n) {
    x := 0.0
    for i := 0; i < n; i++ { x = x * 0.999 + 0.75 }
    return n
})

all += bench("array     ", 100000, (n) {
    arr := []
    for i := 0; i < 3000; i++ { arr.push(i) }
    for i := 0; i < n; i++ { arr[i % 3000] = arr[(i + 1) % 3000] + 1 }
    return n
})

all += bench("sieve     ", 3000, (n) {
    flags := []
    for i := 0; i <= n; i++ { flags.push(1) }
    marks := 0
    for i := 2; i * i <= n; i++ {
        if flags[i] == 1 {
            j := i * i
            while j <= n {
                flags[j] = 0
                marks += 1
                j += i
            }
        }
    }
    return marks
})

all += bench("strings   ", 1500, (n) {
    s := ""
    for i := 0; i < n; i++ { s ~= "x" }
    return n
})

all += bench("trig      ", 3000, (n) {
    x := 0.0
    for i := 0; i < n; i++ { x += sin(i * 0.01) + cos(i * 0.01) }
    return n * 2
})

all += bench("sort      ", 300, (n) {
    data := []
    for i := 0; i < n; i++ { data.push((i * 7919) % 1000) }
    data.sort()
    return n
})

println("--- total secs:", all, "---")
