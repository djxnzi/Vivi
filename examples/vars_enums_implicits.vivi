Names :: {
    Tom,
    Dick,
    Harry
}

Colors :: {
    Red,
    Green,
    Blue
}

Codes :: {
    Low: 10,
    Mid: 20,
    High: 30
}

Vec2 :: {
    x: 0,
    y: 0
}

early :: .Harry

a :: .Dick
b := .Tom

// Variadic passthrough
passthrough :: (...) {
    println(argc)
    for i := 0; i < argc; i++ {
        println(argv[i])
    }
}

variadic :: (...) {
    passthrough(args)
}

bundled :: (...) {
    passthrough(argc, argv)
}

shape :: (...) {
    println(args[0])
    println(args[1])
}

// Enum Selectors
enums :: () {
    is_tom :: (n) { return n == .Tom }
    pick :: () { return .Blue }

    println(early)              // 2
    println(a)                  // 1
    println(b)                  // 0
    println(Names.Harry)        // 2
    println(a == .Dick)         // true
    println(is_tom(.Tom))       // true
    println(is_tom(.Dick))      // false
    println(pick())             // 2

    switch b {
        .Tom:
            println("switch .Tom")
        default:
            println("switch default")
    }
}

i_ix_tests :: () {
    for Names {
        println(i)              // 0, 1, 2
        println(ix)             // 0, 1, 2, same as Names.Tom, Names.Dick, Names.Harry
    }

    for Codes {
        println(i)              // 0, 1, 2
        println(ix)             // 10, 20, 30
    }

    a := ["a", "b", "c"]
    for a {
        println(i)              // 0, 1, 2
        println(ix)             // a, b, c
    }

    v := Vec2(3, 4)
    for v {
        println(i)              // 0, 1
        println(ix)             // 3, 4
    }

}

main :: () {
    variadic("test", 1, "apple", 420)   // 4, test, 1, apple, 420
    bundled("test", 1, "apple", 420)    // 2, 4, ["test", 1, "apple", 420]
    shape("test", 1, "apple", 420)      // 4, ["test", 1, "apple", 420]

    enums()
    i_ix_tests()
}