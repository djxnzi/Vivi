// String Functions

i32 index_of := (string str, string substr, i32 from := 0) {
    if (substr.len == 0) return -1
    if (from < 0) from = 0

    for (i := from; i <= str.len - substr.len; i++) {
        match := true
        for (j := 0; j < substr.len; j++) {
            if (str.char_at(i + j) != substr.char_at(j)) {
                match = false
                break
            }
        }
        if match return i
    }

    return -1
}

bool is_digit := (rune c) {
    n := i32(c)
    return n >= 48 && n <= 57
}

bool has_prefix := (string str, string prefix) {
    if (prefix.len > str.len) {
        return false
    }

    for (i := 0; i < prefix.len; i++) {
        if (str.char_at(i) != prefix.char_at(i)) {
            return false
        }
    }

    return true
}

bool has_suffix := (string str, string suffix) {
    if (suffix.len > str.len) {
        return false
    }

    offset := str.len - suffix.len
    for (i in 0..suffix.len - 1) {
        if str.char_at(offset + i) != suffix.char_at(i) return false
    }

    return true
}

bool contains := (string str, string substr) {
    if (substr.len == 0) return true
    if (substr.len > str.len) return false

    for (i := 0; i <= str.len - substr.len; i++) {
        match := true
        for (j := 0; j < substr.len; j++) {
            if (str.char_at(i + j) != substr.char_at(j)) {
                match = false
                break
            }
        }

        if match return true
    }

    return false
}

string substring := (string str, i32 start := null, i32 end := null) {

    arr := []

    for (i := 0; i < str.len; i++) {
        arr.push(str.char_at(i));
    }

    start   = (start == null || start < 0) ? 0 : start
    end     = (end == null || end > str.len) ? str.len : end
    start   = start < str.len ? start : str.len

    if (start > end) {
        [start, end] = [end, start]
    }

    result := ""

    for (i := start; i < end; i++) {
        result = result ~ str.char_at(i)
    }

    return result
}

array split := (string str, string delimiter := null) {
    if (str.len() == 0) panic("Cannot split an empty string!")

    start   := 0
    result  := []

    if (delimiter == null || delimiter.len == 0) {
        for (i := 0; i < str.len(); i++) {
            result.push(str.char_at(i))
        }
    } else {
        index := index_of(str, delimiter, start)
        while (index != -1) {
            result.push(substring(str, start, index))
            start = index + delimiter.len
            index = index_of(str, delimiter, start)
        }
        result.push(substring(str, start))
    }

    return result
}

string join := (string str1, string str2) {
    // Redundant, for js devs
    return str1 ~ str2
}

string replace := (string str, string target, string replacement) {
    if replace == null return str

    for (i := 0; i <= str.len - target.len; i++) {
        if (substring(str, i, i + target.len) == target) {
            return substring(str, 0, i) ~ replacement ~ substring(str, i + target.len, str.len)
        }
    }

    return str
}

string trim := (string str) {
    whitespace  := [" ", "\t", "\n", "\r"]

    start := 0
    while (start < str.len && str.char_at(start) in whitespace) {
        start++
    }

    end := str.len
    while (end > start && str.char_at(end - 1) in whitespace) {
        end--
    }

    return substring(str, start, end)
}

string to_upper := (string str) {
    out := ""
    for i := 0; i < str.len; i++ {
        c := i32(str.char_at(i))
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        out = out ~ rune(c)
    }
    return out
}

string to_lower := (string str) {
    out := ""
    for i := 0; i < str.len; i++ {
        c := i32(str.char_at(i))
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = out ~ rune(c)
    }
    return out
}

string reverse := (string str) {
    out := ""
    for (i := str.len - 1; i >= 0; i--) {
        out = out ~ str.char_at(i)
    }
    return out
}

string to_pascal_case := (string str) {
    out := ""
    new_word := true
    for (i := 0; i < str.len; i++) {
        c := i32(str.char_at(i))
        if (c == 32) {
            new_word = true
        } else {
            if (new_word && c >= 97 && c <= 122) c = c - 32
            if (!new_word && c >= 65 && c <= 90) c = c + 32
            out = out ~ rune(c)
            new_word = false
        }
    }
    return out
}

string to_camel_case := (string str) {
    out := ""
    new_word := false
    started := false
    for (i := 0; i < str.len; i++) {
        c := i32(str.char_at(i))
        if (c == 32) {
            new_word = started
        } else {
            if (new_word && c >= 97 && c <= 122) c = c - 32
            if (!new_word && c >= 65 && c <= 90) c = c + 32
            out = out ~ rune(c)
            new_word = false
            started = true
        }
    }
    return out
}

string to_snake_case := (string str) {
    out := ""
    for (i := 0; i < str.len; i++) {
        c := i32(str.char_at(i))
        if (c == 32) {
            out = out ~ "_"
        } else {
            if (c >= 65 && c <= 90) c = c + 32
            out = out ~ rune(c)
        }
    }
    return out
}

// Time Functions

program_start :: timestamp()
last_time := program_start

now := () {
    return i32(timestamp())
}

dt := (c := now()) {
    dt := (c - last_time) * 1000
    last_time = c
    return dt
}

dateTime := (c := i64(now())) {
    u32 s       := c % 86400
    u32 seconds := s % 60
    u32 minutes := (s % 3600) / 60
    u32 hours   := s / 3600
    u32 days    := c / 86400
    year        := 1970
    is_leap     := 0

    while (true) {
        is_leap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
        days_in_year := is_leap ? 366 : 365
        if (days >= days_in_year) {
            days -= days_in_year
            year++
        } else {
            break
        }
    }

    is_leap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
    days_in_months := is_leap
        ? [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
        : [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

    month := 0
    while (days >= days_in_months[month]) {
        days -= days_in_months[month]
        month++
    }

    month += 1
    day := days + 1

    return [day, month, year]
}

getTime := (c := i64(now()), base_offset := i64(0), zulu := true) {
    day   := dateTime()[0]
    month := dateTime()[1]
    year  := dateTime()[2]

    days_to_mar1 := 0
    y := 1970
    while (y < year) {
        leap_y := (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
        days_to_mar1 = days_to_mar1 + (leap_y ? 366 : 365)
        y = y + 1
    }
    is_leap_curr := (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
    days_to_mar1 = days_to_mar1 + 31 + (is_leap_curr ? 29 : 28)

    dow_mar1 := (4 + days_to_mar1) % 7
    first_sun_mar := dow_mar1 == 0 ? 1 : (7 - dow_mar1 + 1)
    second_sun_mar := first_sun_mar + 7

    days_to_nov1 := days_to_mar1 + 245
    dow_nov1 := (4 + days_to_nov1) % 7
    first_sun_nov := dow_nov1 == 0 ? 1 : (7 - dow_nov1 + 1)

    in_dst := false
    if (month > 3 && month < 11) {
        in_dst = true
    } else if (month == 3 && day >= second_sun_mar) {
        in_dst = true
    } else if (month == 11 && day < first_sun_nov) {
        in_dst = true
    }

    dst_offset := in_dst ? 3600 : 0

    local_secs := (c + (base_offset * 3600) + dst_offset) % 86400
    if local_secs < 0 local_secs = local_secs + 86400

    u32 s           := u32(local_secs)
    u32 hours       := s / 3600
    u32 minutes     := (s % 3600) / 60
    u32 seconds     := s % 60
    string meridiem := ""

    if (zulu) {
        hours = hours      < 10 ? "0" : ""
        minutes = minutes  < 10 ? "0" : ""
        seconds = seconds  < 10 ? "0" : ""
    } else {
        meridiem = hours < 12 ? "AM" : "PM"

        hours = hours == 0  ? 12 : hours > 12   ? hours - 12 : hours
    }

    return [hours, minutes, seconds, meridiem]
}

// Tomohiko Sakamoto Algorithm
getDay := (i32 d := dateTime()[0], i32 m := dateTime()[1], i32 y := dateTime()[2]) {
    t := [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    
    if (m < 3) y -= 1
    
    day := ((y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7)

    switch day {
        0: return "Sunday"
        1: return "Monday"
        2: return "Tuesday"
        3: return "Wednesday"
        4: return "Thursday"
        5: return "Friday"
        6: return "Saturday"
    }
}

getMonth := (m := dateTime()[1]) {
    switch m {
        0: return "January"
        1: return "February"
        2: return "March"
        3: return "April"
        4: return "May"
        5: return "June"
        6: return "July"
        7: return "August"
        8: return "September"
        9: return "October"
        10: return "November"
        11: return "December"
    }
}

i32 getYear := (i32 y := dateTime()[2]) {
    return y
}

formatDate := (string d := getDay(), string m := getMonth(), i32 y := getYear()) {
    return "{d}, {m} {y}"
}