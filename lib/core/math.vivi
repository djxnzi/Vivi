f32 pi      :: 3.141592653589793
f32 e       :: 2.718281828459045
f32 tau     :: 2 * pi
inf         :: f32(1) / f32(0)
nan         :: f32(0) / f32(0)
f64 epsilon :: 0.000000000001
ln2         :: 0.6931471805599453
ln10        :: 2.302585092994046

abs := (x) {
    return (x < 0 ? -x : x)
}

min := (a, b) {
    return (a < b ? a : b)
}

max := (a, b) {
    return (a > b ? a : b)
}

clamp := (x, low, high) {
    return if (x < low) {
        low
    } else if (x > high) {
        high
    } else {
        x
    }
}

lerp := (a, b, t) {
    return (a + (b - a) * t)
}

sign := (x) {
    return if (x > 0) {
        1
    } else if (x < 0) {
        -1
    } else {
        0
    }
}

copysign := (x, y) {
    return if (y < 0) {
        -abs(x)
    } else {
        abs(x)
    }
}

trunc := (x) {
    return f32(i32(x))
}

floor := (x) {
    t := i32(x)
    if (x >= 0 || f32(t) == x) {
        return f32(t)
    }
    return f32(t - 1)
}

ceil := (x) {
    t := i32(x)
    if (x <= 0 || f32(t) == x) {
        return f32(t)
    }
    return f32(t + 1)
}

round := (x) {
    i := floor(x)
    frac := x - i
    if (frac < 0.5) {
        return i
    } else if (frac > 0.5) {
        return i + 1
    } else {
        if (i32(i) % 2 == 0) {
            return i
        } else {
            return i + 1
        }
    }
}

fmod := (x, y) {
    return x - f32(i32(x / y)) * y
}

modf := (x) {
    intpart := f32(i32(x))
    frac := x - intpart
    return [frac, intpart]
}

sqrt := (x) {
    if (x < 0) {
        panic("sqrt domain error")
    } else if (x == 0) {
        return 0
    }
    guess := x
    for (i := 0; i < 20; i++) {
        guess = 0.5 * (guess + x / guess)
    }
    return guess
}

exp := (x) {
    if (x > 700)  { return inf }
    if (x < -700) { return 0.0 }
    if (x < 0) {
        return 1.0 / exp(-x)
    }
    result := 1.0
    term   := 1.0
    n := 1
    while (abs(term) > epsilon) {
        term = term * x / n
        result = result + term
        n = n + 1
    }
    return result
}

f64 log := (x) {
    if (x <= 0) { panic("log domain error") }
    if (x == 1) { return 0.0 }
    k := 0
    while (x >= 2) {
        x = x / 2.0
        k = k + 1
    }
    while (x < 1.0) {
        x = x * 2.0
        k = k - 1
    }
    u := x - 1.0
    sum := 0.0
    term := u
    n := 1.0
    sign := 1.0
    while (abs(term / n) > epsilon) {
        sum = sum + sign * term / n
        term = term * u
        sign = -sign
        n = n + 1.0
    }
    return sum + f64(k) * ln2
}

f64 log10 := (x) {
    return log(x) / ln10
}

log2 := (x) {
    return log(x) / ln2
}

expm1 := (x) {
    if (abs(x) < 0.01) {
        sum := 0.0
        term := x
        n := 1
        while (abs(term) > epsilon) {
            sum = sum + term
            term = term * x / (n + 1)
            n = n + 1
        }
        return sum
    }
    return exp(x) - 1
}

cbrt := (x) {
    if (x == 0) { return 0 }
    guess := x
    for (i := 0; i < 20; i++) {
        guess = (2 * guess + x / (guess * guess)) / 3
    }
    return guess
}

hypot := (a, b) {
    a = f32(abs(a))
    b = f32(abs(b))
    if (a == 0 && b == 0) { return 0 }
    if (a > b) {
        return a * sqrt(1 + (b / a) * (b / a))
    }
    return b * sqrt(1 + (a / b) * (a / b))
}

pow := (base, exponent) {
    if (exponent == 0) { return 1 }
    if (base == 0) {
        if (exponent < 0) { panic("pow domain error") }
        return 0
    }
    if (base < 0 && exponent != f32(i32(exponent))) { return nan }
    result := exp(exponent * log(abs(base)))
    if (base < 0 && i32(exponent) % 2 == 1) { result = -result }
    return result
}

sin := (x) {
    x = fmod(x, 2 * pi)
    if (x < 0) { return -sin(-x) }
    if (x > pi) { x = 2 * pi - x }
    if (x > pi / 2) { x = pi - x }
    result := 0.0
    term := x
    n := 1
    sign := 1
    while (abs(term) > epsilon) {
        result = result + sign * term
        term = term * x * x / ((2 * n) * (2 * n + 1))
        sign = -sign
        n = n + 1
    }
    return result
}

cos := (x) {
    return sin(pi / 2 - x)
}

tan := (x) {
    c := cos(x)
    if (c == 0) { panic("tan undefined") }
    return sin(x) / c
}

atan := (x) {
    if (x == 1)  { return pi / 4 }
    if (x == -1) { return -pi / 4 }
    if (abs(x) > 1) {
        if (x > 0) { return pi / 2 - atan(1 / x) }
        return -pi / 2 - atan(1 / x)
    }
    if (abs(x) > 0.5) {
        return pi / 4 - atan((1 - x) / (1 + x))
    }
    result := 0.0
    term := x
    n := 1.0
    sign := 1.0
    while (abs(term / n) > epsilon) {
        result = result + sign * term / n
        term = term * x * x
        sign = -sign
        n = n + 2.0
    }
    return result
}

atan2 := (y, x) {
    if (x > 0) {
        return atan(y / x)
    } else if (x < 0) {
        if (y >= 0) { return atan(y / x) + pi }
        return atan(y / x) - pi
    } else {
        if (y > 0)  { return pi / 2 }
        if (y < 0)  { return -pi / 2 }
        return 0
    }
}

asin := (x) {
    if (abs(x) > 1) { panic("asin domain error") }
    return atan2(x, sqrt(1 - x * x))
}

acos := (x) {
    return pi / 2 - asin(x)
}

sinh := (x) {
    return (exp(x) - exp(-x)) / 2
}

cosh := (x) {
    return (exp(x) + exp(-x)) / 2
}

tanh := (x) {
    return sinh(x) / cosh(x)
}

asinh := (x) {
    return log(x + sqrt(x * x + 1))
}

acosh := (x) {
    if (x < 1) { panic("acosh domain error") }
    return log(x + sqrt(x * x - 1))
}

atanh := (x) {
    if (abs(x) >= 1) { panic("atanh domain error") }
    return 0.5 * log((1 + x) / (1 - x))
}

deg_to_rad := (d) {
    return d * (pi / 180)
}

rad_to_deg := (r) {
    return r * (180 / pi)
}

gcd := (a, b) {
    a = abs(a)
    b = abs(b)
    t := b
    while (b != 0) {
        t = b
        b = i32(a) % i32(b)
        a = t
    }
    return a
}

lcm := fn (a, b) {
    if (a == 0 && b == 0) { return 0 }
    return abs(a) / gcd(a, b) * abs(b)
}

factorial := (n) {
    if (n < 0) { panic("factorial domain error") }
    result := 1
    for (i := 2; i <= n; i++) {
        result = result * i
    }
    return result
}

gamma := (x) {
    if (x <= 0 and x == f32(i32(x))) { panic("gamma pole") }
    c := [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
          771.32342877765313, -176.61502916214059, 12.507343278686905,
          -0.13857109526572012, 0.0000099843695780195716]
    tmp := x + 7 - 0.5
    sum := c[0]
    for (i := 1; i <= 7; i++) {
        sum = sum + c[i] / (x + i - 1)
    }
    return sqrt(2 * pi) * pow(tmp, x - 0.5) * exp(-tmp) * sum
}

erf := (x) {
    s := 1
    if (x < 0) { s = -1; x = -x }
    t := 1.0 / (1.0 + 0.3275911 * x)
    poly := t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))))
    return s * (1.0 - poly * exp(-x * x))
}

erfc := (x) {
    return 1.0 - erf(x)
}