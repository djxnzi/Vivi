// print functions

print := (...) {
    _write(1, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(1, " " ~ string(argv[i]))
    }
}

println := (...) {
    _write(1, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(1, " " ~ string(argv[i]))
    }

    _write(1, "\n")
}

printf := (string fmt, ...) {
    a := 0
    for i := 0; i < fmt.len; i++ {
        if fmt.char_at(i) == "%" {
            i++
            if i >= fmt.len {
                print("%")
                break
            }
            spec := fmt.char_at(i)
            base := 10
            switch spec {
                "x":
                    base = 16
                    fallthrough
                "d":
                    n := i32(argv[a])
                    a++
                    if n == 0 {
                        print("0")
                    }
                    is_negative := false
                    if n < 0 {
                        if base == 10 {
                            is_negative = true
                            n = -n
                        } else {
                            n += 4294967296
                        }
                    }
                    buf := []
                    while n > 0 {
                        rem := n % base
                        if rem < 10 {
                            buf.push(rune(rem + 48))
                        } else {
                            buf.push(rune(rem - 10 + 97))
                        }
                        n = n / base
                    }
                    if is_negative {
                        print("-")
                    }
                    j := buf.len - 1
                    while j >= 0 {
                        print(string(buf[j]))
                        j -= 1
                    }
                "s":
                    s := argv[a]
                    a++
                    if s == null {
                        s = "(null)"
                    }
                    print(string(s))
                "c":
                    print(string(rune(argv[a])))
                    a++
                "%":
                    print("%")
                default:
                    print("%" ~ spec)
            }
        } else {
            print(string(fmt.char_at(i)))
        }
    }
}

// stderr prints

eprint := (...) {
    _write(2, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(2, " " ~ string(argv[i]))
    }
}

eprintln := (...) {
    _write(2, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(2, " " ~ string(argv[i]))
    }
    _write(2, "\n")
}

eprintf := (string fmt, ...) {
    a := 0
    for i := 0; i < fmt.len; i++ {
        if fmt.char_at(i) == "%" {
            i++
            if i >= fmt.len {
                eprint("%")
                break
            }
            spec := fmt.char_at(i)
            base := 10
            switch spec {
                "x":
                    base = 16
                    fallthrough
                "d":
                    n := i32(argv[a])
                    a++
                    if n == 0 {
                        eprint("0")
                    }
                    is_negative := false
                    if n < 0 {
                        if base == 10 {
                            is_negative = true
                            n = -n
                        } else {
                            n += 4294967296
                        }
                    }
                    buf := []
                    while n > 0 {
                        rem := n % base
                        if rem < 10 {
                            buf.push(rune(rem + 48))
                        } else {
                            buf.push(rune(rem - 10 + 97))
                        }
                        n = n / base
                    }
                    if is_negative {
                        eprint("-")
                    }
                    j := buf.len - 1
                    while j >= 0 {
                        eprint(string(buf[j]))
                        j -= 1
                    }
                "s":
                    s := argv[a]
                    a++
                    if s == null {
                        s = "(null)"
                    }
                    eprint(string(s))
                "c":
                    eprint(string(rune(argv[a])))
                    a++
                "%":
                    eprint("%")
                default:
                    eprint("%" ~ spec)
            }
        } else {
            eprint(string(fmt.char_at(i)))
        }
    }
}

exit := (i32 code := 0) {
    code = code % 256
    exit_codes := [0, 1, 2, 127, 134]
    if code in exit_codes {
        _exit(code);
    } else {
        println("Program exited with abnormal exit code {code}")
        _exit(code);
    }
}
panic := (string str) {
    /* Exit codes:
        0: ok
        1: runtime error
        2: parse error
        127: file not found
        134: panic
    */
    println("panic(): {str}")
    println(_traceback());
    exit(134);
}

// Memory Management and such.

_heap_ptr := 0
_heap_end := 0

malloc := (size) {
    size = (size + 15) / 16 * 16
    total := size + 16               // 16-byte header keeps alignment
    if _heap_ptr + total > _heap_end {
        chunk := 1048576
        if total > chunk { chunk = total }
        _heap_ptr = _mmap(chunk)
        if _heap_ptr == null { panic("malloc(): out of memory!!") }
        _heap_end = _heap_ptr + chunk
    }
    p := _heap_ptr
    _heap_ptr += total
    n := size
    for i := 0; i < 8; i++ {         // store size in the header
        _poke(p + i, n % 256)
        n = n / 256
    }
    return p + 16
}

free := (ptr) { }                    // free list comes later as it should.

memcpy := (dst, src, n) { _memcpy(dst, src, n) }

timestamp := () {
    return _clock()
}

traceback := () {
    return _traceback()
}

rand := () {
    return _rand()
}

seed := (i32 n) {
    _seed(n)
}

i32 hash := (string v) {
    h := 0
    n := _len(v)
    i := 0
    while i < n {
        h = ((h << 5) ^ (h >> 2)) ^ _get(v, i)
        i += 1
    }
    return h
}

// Methods

#method len := () {
    return _len(self)
}

#method char_at :: (i) {
    if i < 0 or i >= _len(self) {
        panic("char_at() index out of range")
    }
    return rune(_get(self, i))
}

#method push :: (v) {
    _set(self, _len(self), v)
}

#method pop :: () {
    n := _len(self)
    if n == 0 { panic("Cannot pop from an empty array") }
    v := _get(self, n - 1)
    _trunc(self, n - 1)
    return v
}

#method empty :: () {
    _trunc(self, 0)
}

#method add :: (i, v) {
    n := _len(self)
    j := n
    while j > i {
        _set(self, j, _get(self, j - 1))
        j -= 1
    }
    _set(self, i, v)
}

#method take :: (i) {
    n := _len(self)
    if i < 0 or i >= n { panic("take() index out of range") }
    v := _get(self, i)
    j := i
    while j < n - 1 {
        _set(self, j, _get(self, j + 1))
        j += 1
    }
    _trunc(self, n - 1)
    return v
}

_is_num := (v) {
    return v == i32 or v == f32
}

_lower_at := (s, i) {
    c := _get(s, i)
    if c >= 65 and c <= 90 { return c + 32 }
    return c
}

_text_greater := (l, r) {
    ls := string(l)
    rs := string(r)
    ln := _len(ls)
    rn := _len(rs)
    n := ln
    if rn < n { n = rn }
    k := 0
    while k < n {
        lc := _lower_at(ls, k)
        rc := _lower_at(rs, k)
        if lc != rc { return lc > rc }
        k += 1
    }
    return ln > rn
}

#method sort :: () {
    n := _len(self)
    c := 0
    while c < n {
        e := _get(self, c)
        if !(_is_num(e) or e == string or e == rune) {
            panic("sort() can't order null, bool, array, struct or function values")
        }
        c += 1
    }

    i := 1
    while i < n {
        vi := _get(self, i)
        j := i - 1
        while j >= 0 {
            lv := _get(self, j)
            greater := false
            if _is_num(lv) and _is_num(vi) {
                greater = lv > vi
            } else {
                greater = _text_greater(lv, vi)
            }
            if !greater { break }
            _set(self, j + 1, lv)
            j -= 1
        }
        _set(self, j + 1, vi)
        i += 1
    }
}



// Casts

bool := (v, mode := "") {
    return _cast(v, "bool", mode)
}
i8 := (v, mode := "") {
    return _cast(v, "i8", mode)
}
i16 := (v, mode := "") {
    return _cast(v, "i16", mode)
}
i32 := (v, mode := "") {
    return _cast(v, "i32", mode)
}
i64 := (v, mode := "") {
    return _cast(v, "i64", mode)
}
u8 := (v, mode := "") {
    return _cast(v, "u8", mode)
}
u16 := (v, mode := "") {
    return _cast(v, "u16", mode)
}
u32 := (v, mode := "") {
    return _cast(v, "u32", mode)
}
u64 := (v, mode := "") {
    return _cast(v, "u64", mode)
}
f32 := (v, mode := "") {
    return _cast(v, "f32", mode)
}
f64 := (v, mode := "") {
    return _cast(v, "f64", mode)
}
rune := (v, mode := "") {
    return _cast(v, "rune", mode)
}
string := (v, mode := "") {
    return _cast(v, "string", mode)
}
// Explicit cast
cast := (*v, type, mode := "") {
    v* = type(v*, mode)
    return v*
}

int := i32
float := f32


// Phrase example
#phrase unless :: (cond, block body) {
    if !cond {
        return body
    }
}

/*

    unless false {
        print("this runs")
    }

    unless true {
        print("this is skipped")
    }

*/
