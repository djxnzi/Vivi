int := i32
float := f32

// Casts

bool := (v, mode := "") {
    return _cast(v, "bool", mode)
}
i8 := (v, mode := "") {
    return _cast(v, "i8", mode)
}
i16 := (v, mode := "") {
    return _cast(v, "i16", mode)
}
i32 := (v, mode := "") {
    return _cast(v, "i32", mode)
}
i64 := (v, mode := "") {
    return _cast(v, "i64", mode)
}
u8 := (v, mode := "") {
    return _cast(v, "u8", mode)
}
u16 := (v, mode := "") {
    return _cast(v, "u16", mode)
}
u32 := (v, mode := "") {
    return _cast(v, "u32", mode)
}
u64 := (v, mode := "") {
    return _cast(v, "u64", mode)
}
f32 := (v, mode := "") {
    return _cast(v, "f32", mode)
}
f64 := (v, mode := "") {
    return _cast(v, "f64", mode)
}
rune := (v, mode := "") {
    return _cast(v, "rune", mode)
}
string := (v, mode := "") {
    return _cast(v, "string", mode)
}
// Explicit cast
cast := (*v, type, mode := "") {
    v* = type(v*, mode)
    return v*
}





// Wrappers

timestamp := () { return _timestamp() }
traceback := () { return _traceback() }
seed := (i32 n) { _seed(n) }
rand := () { return _rand() }
sleep := (n) { _sleep(n) }
get_at := (v, i) { return _get(v, i) }
set_at := (*a, v, i) { return _set(a*, v, i) }

fopen := (path, mode) { return _open(path, mode) }
fread := (fd, chunk_size) { return _read(fd, chunk_size) }
fwrite := (fd, str) { return _write(fd, str) }
fclose := (fd) { return _close(fd) }

mmap := (size) { return _mmap(size) }
munmap := (addr, size) { return _munmap(addr, size) }
peek := (addr) { return _peek(addr) }
poke := (addr, byte) { return _poke(addr, byte) }
memcpy := (dst, src, n) { return _memcpy(dst, src, n) }





// print functions

// Standard file descriptors on *nix systems
STD_DESCRIPTORS := {
    STDOUT: 1,
    STDERR: 2
}

fprintf := (int fd, string fmt, ...) {
    a := 0
    for i := 0; i < fmt.len; i++ {
        if fmt.char_at(i) == "%" {
            i++
            if i >= fmt.len {
                fprint(fd, "%")
                break
            }
            spec := fmt.char_at(i)
            base := 10
            switch spec {
                "x":
                    base = 16
                    fallthrough
                "d":
                    n := i32(argv[a])
                    a++
                    if n == 0 {
                        fprint(fd, "0")
                    }
                    is_negative := false
                    if n < 0 {
                        if base == 10 {
                            is_negative = true
                            n = -n
                        } else {
                            n += 4294967296
                        }
                    }
                    buf := []
                    while n > 0 {
                        rem := n % base
                        if rem < 10 {
                            buf.push(rune(rem + 48))
                        } else {
                            buf.push(rune(rem - 10 + 97))
                        }
                        n = n / base
                    }
                    if is_negative {
                        fprint(fd, "-")
                    }
                    j := buf.len - 1
                    while j >= 0 {
                        fprint(fd, string(buf[j]))
                        j -= 1
                    }
                "s":
                    s := argv[a]
                    a++
                    if s == null {
                        s = "(null)"
                    }
                    fprint(fd, string(s))
                "c":
                    fprint(fd, string(rune(argv[a])))
                    a++
                "%":
                    fprint(fd, "%")
                default:
                    fprint(fd, "%" ~ spec)
            }
        } else {
            fprint(fd, string(fmt.char_at(i)))
        }
    }
}

print := (...) {
    fprint(.STDOUT, args)
}

fprint := (int fd, ...) {
    _write(fd, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(fd, " " ~ string(argv[i]))
    }
}

println := (...) {
    _write(.STDOUT, string(argv[0]))
    for i := 1; i < argc; i++ {
        _write(.STDOUT, " " ~ string(argv[i]))
    }
    _write(.STDOUT, "\n")
}

printf := (string fmt, ...) {
    fprintf(.STDOUT, fmt, args)
}

eprint := (...) {
    fprint(.STDERR, args)
}

eprintln := (...) {
    eprint(args)
    _write(.STDERR, "\n")
}

eprintf := (string fmt, ...) {
    fprintf(.STDERR, fmt, args)
}





// Exit/Panic

exit := (i32 code := 0) {
    if code in [67, 69, 420, 1337] {
        println("Program exited with funny number {code}")
        _exit(code)
    }

    code = code % 256
    exit_codes := [0, 1, 2, 127, 134]
    if code in exit_codes {
        _exit(code);
    } else {
        println("Program exited with abnormal exit code {code}")
        _exit(code);
    }
}

panic := (string str) {
    /* Exit codes:
        0: ok
        1: runtime error
        2: parse error
        127: file not found
        134: panic
    */
    println("panic(): {str}")
    println(_traceback());
    exit(134);
}





// Methods

#method len := () {
    return _len(self)
}

#method char_at := (i) {
    if i < 0 or i >= _len(self) {
        panic("char_at() index out of range")
    }
    return rune(_get(self, i))
}

#method push := (v) {
    _set(self, _len(self), v)
}

#method pop := () {
    n := _len(self)
    if n == 0 { panic("Cannot pop from an empty array") }
    v := _get(self, n - 1)
    _trunc(self, n - 1)
    return v
}

#method empty := () {
    _trunc(self, 0)
}

#method add := (i, v) {
    n := _len(self)
    j := n
    while j > i {
        _set(self, j, _get(self, j - 1))
        j -= 1
    }
    _set(self, i, v)
}

#method take := (i) {
    n := _len(self)
    if i < 0 or i >= n { panic("take() index out of range") }
    v := _get(self, i)
    j := i
    while j < n - 1 {
        _set(self, j, _get(self, j + 1))
        j += 1
    }
    _trunc(self, n - 1)
    return v
}

#method sort := () {

    _is_num := (v) {
        return v == i32 or v == f32
    }

    _lower_at := (s, i) {
        c := _get(s, i)
        if c >= 65 and c <= 90 { return c + 32 }
        return c
    }

    _text_greater := (l, r) {
        ls := string(l)
        rs := string(r)
        ln := _len(ls)
        rn := _len(rs)
        n := ln
        if rn < n { n = rn }
        k := 0
        while k < n {
            lc := _lower_at(ls, k)
            rc := _lower_at(rs, k)
            if lc != rc { return lc > rc }
            k += 1
        }
        return ln > rn
    }

    n := _len(self)
    c := 0
    while c < n {
        e := _get(self, c)
        if !(_is_num(e) or e == string or e == rune) {
            panic("sort() can't order null, bool, array, struct or function values")
        }
        c += 1
    }

    i := 1
    while i < n {
        vi := _get(self, i)
        j := i - 1
        while j >= 0 {
            lv := _get(self, j)
            greater := false
            if _is_num(lv) and _is_num(vi) {
                greater = lv > vi
            } else {
                greater = _text_greater(lv, vi)
            }
            if !greater { break }
            _set(self, j + 1, lv)
            j -= 1
        }
        _set(self, j + 1, vi)
        i += 1
    }
}





// Phrase example
#phrase unless :: (cond, block body) {
    if !cond {
        return body
    }
}

/*

    unless false {
        print("this runs")
    }

    unless true {
        print("this is skipped")
    }

*/
