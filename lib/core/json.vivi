// json.vivi.
// this was not as easy as i thought it was to make sure it worked.

json_text := ""
json_pos := 0
json_err := null

json_error := () {
    return json_err
}

json_at := (i) {
    return i32(json_text.char_at(i))
}

json_fail := (msg) {
    if json_err != null { return null }
    line := 1
    col := 1
    i := 0
    while i < json_pos and i < json_text.len {
        if json_at(i) == 10 {
            line += 1
            col = 1
        } else {
            col += 1
        }
        i += 1
    }
    json_err = "json: " ~ msg ~ " (line " ~ string(line) ~ ", column " ~ string(col) ~ ")"
    return null
}

json_is_digit := (code) {
    return code >= 48 and code <= 57
}

json_skip := () {
    n := json_text.len
    while json_pos < n {
        code := json_at(json_pos)
        if code == 32 or code == 9 or code == 10 or code == 13 {
            json_pos += 1
        } else {
            break
        }
    }
}

json_hexval := (code) {
    if code >= 48 and code <= 57 { return code - 48 }
    if code >= 97 and code <= 102 { return code - 87 }
    if code >= 65 and code <= 70 { return code - 55 }
    return -1
}

json_hex4 := () {
    v := 0
    k := 0
    while k < 4 {
        if json_pos >= json_text.len {
            json_fail("truncated unicode escape")
            return -1
        }
        h := json_hexval(json_at(json_pos))
        if h < 0 {
            json_fail("invalid unicode escape")
            return -1
        }
        v = v * 16 + h
        json_pos += 1
        k += 1
    }
    return v
}

json_utf8 := (cp) {
    out := ""
    if cp < 128 {
        out = out ~ rune(cp)
    } else if cp < 2048 {
        out = out ~ rune(192 + i32(cp / 64))
        out = out ~ rune(128 + cp % 64)
    } else if cp < 65536 {
        out = out ~ rune(224 + i32(cp / 4096))
        out = out ~ rune(128 + i32(cp / 64) % 64)
        out = out ~ rune(128 + cp % 64)
    } else {
        out = out ~ rune(240 + i32(cp / 262144))
        out = out ~ rune(128 + i32(cp / 4096) % 64)
        out = out ~ rune(128 + i32(cp / 64) % 64)
        out = out ~ rune(128 + cp % 64)
    }
    return out
}

json_string := () {
    n := json_text.len
    out := ""
    json_pos += 1
    while true {
        if json_pos >= n {
            json_fail("unterminated string")
            return null
        }
        code := json_at(json_pos)
        if code == 34 {
            json_pos += 1
            return out
        }
        if code == 92 {
            json_pos += 1
            if json_pos >= n {
                json_fail("unterminated escape")
                return null
            }
            esc := json_at(json_pos)
            if esc == 117 {
                json_pos += 1
                cp := json_hex4()
                if json_err != null { return null }
                if cp >= 55296 and cp <= 56319 {
                    if json_pos + 1 < n and json_at(json_pos) == 92 and json_at(json_pos + 1) == 117 {
                        json_pos += 2
                        lo := json_hex4()
                        if json_err != null { return null }
                        if lo >= 56320 and lo <= 57343 {
                            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                        } else {
                            json_fail("invalid surrogate pair")
                            return null
                        }
                    } else {
                        json_fail("lone surrogate in string")
                        return null
                    }
                } else if cp >= 56320 and cp <= 57343 {
                    json_fail("lone surrogate in string")
                    return null
                }
                out = out ~ json_utf8(cp)
            } else {
                rep := -1
                if esc == 34 { rep = 34 }
                if esc == 92 { rep = 92 }
                if esc == 47 { rep = 47 }
                if esc == 98 { rep = 8 }
                if esc == 102 { rep = 12 }
                if esc == 110 { rep = 10 }
                if esc == 114 { rep = 13 }
                if esc == 116 { rep = 9 }
                if rep < 0 {
                    json_fail("invalid escape sequence")
                    return null
                }
                out = out ~ rune(rep)
                json_pos += 1
            }
        } else {
            out = out ~ json_text.char_at(json_pos)
            json_pos += 1
        }
    }
}

json_number := () {
    n := json_text.len
    neg := false
    if json_at(json_pos) == 45 {
        neg = true
        json_pos += 1
    }
    if json_pos >= n {
        json_fail("invalid number")
        return null
    }
    if !json_is_digit(json_at(json_pos)) {
        json_fail("invalid number")
        return null
    }

    mant := 0
    nd := 0
    scale := 0
    is_float := false

    while json_pos < n and json_is_digit(json_at(json_pos)) {
        d := json_at(json_pos) - 48
        if nd < 18 {
            mant = mant * 10 + d
            if mant > 0 { nd += 1 }
        } else {
            scale += 1
            is_float = true
        }
        json_pos += 1
    }

    if json_pos < n and json_at(json_pos) == 46 {
        is_float = true
        json_pos += 1
        frac_digits := 0
        while json_pos < n and json_is_digit(json_at(json_pos)) {
            fd := json_at(json_pos) - 48
            if nd < 18 {
                mant = mant * 10 + fd
                scale -= 1
                if mant > 0 { nd += 1 }
            }
            frac_digits += 1
            json_pos += 1
        }
        if frac_digits == 0 {
            json_fail("invalid number: digits expected after the dot")
            return null
        }
    }

    if json_pos < n {
        ec := json_at(json_pos)
        if ec == 101 or ec == 69 {
            is_float = true
            json_pos += 1
            eneg := false
            if json_pos < n {
                sc := json_at(json_pos)
                if sc == 43 {
                    json_pos += 1
                } else if sc == 45 {
                    eneg = true
                    json_pos += 1
                }
            }
            ev := 0
            exp_digits := 0
            while json_pos < n and json_is_digit(json_at(json_pos)) {
                ev = ev * 10 + (json_at(json_pos) - 48)
                if ev > 400 { ev = 400 }
                exp_digits += 1
                json_pos += 1
            }
            if exp_digits == 0 {
                json_fail("invalid number: digits expected in exponent")
                return null
            }
            if eneg {
                scale -= ev
            } else {
                scale += ev
            }
        }
    }

    if !is_float {
        if neg { return -mant }
        return mant
    }
    if mant == 0 { return 0.0 }

    result := f64(mant)
    if scale > 0 {
        pow_up := 1.0
        for (su := 0; su < scale; su++) { pow_up = pow_up * 10.0 }
        result = result * pow_up
    } else if scale < 0 {
        pow_dn := 1.0
        for (sd := 0; sd < 0 - scale; sd++) { pow_dn = pow_dn * 10.0 }
        result = result / pow_dn
    }
    if neg { return -result }
    return result
}

json_literal := (word, val) {
    n := json_text.len
    for (j := 0; j < word.len; j++) {
        if json_pos + j >= n {
            json_fail("invalid literal")
            return null
        }
        if json_text.char_at(json_pos + j) != word.char_at(j) {
            json_fail("invalid literal")
            return null
        }
    }
    json_pos += word.len
    return val
}

json_array := (depth) {
    if depth > 512 {
        json_fail("nesting too deep")
        return null
    }
    arr := []
    n := json_text.len
    json_pos += 1
    json_skip()
    if json_pos < n and json_at(json_pos) == 93 {
        json_pos += 1
        return arr
    }
    while true {
        item := json_value(depth + 1)
        if json_err != null { return null }
        arr.push(item)
        json_skip()
        if json_pos >= n {
            json_fail("unterminated array")
            return null
        }
        code := json_at(json_pos)
        if code == 44 {
            json_pos += 1
        } else if code == 93 {
            json_pos += 1
            return arr
        } else {
            json_fail("expected comma or closing bracket in array")
            return null
        }
    }
}

json_object := (depth) {
    if depth > 512 {
        json_fail("nesting too deep")
        return null
    }
    obj := []
    n := json_text.len
    json_pos += 1
    json_skip()
    if json_pos < n and json_at(json_pos) == 125 {
        json_pos += 1
        return obj
    }
    while true {
        json_skip()
        if json_pos >= n {
            json_fail("unterminated object")
            return null
        }
        if json_at(json_pos) != 34 {
            json_fail("expected a string key")
            return null
        }
        key := json_string()
        if json_err != null { return null }
        json_skip()
        if json_pos >= n {
            json_fail("unterminated object")
            return null
        }
        if json_at(json_pos) != 58 {
            json_fail("expected a colon after key")
            return null
        }
        json_pos += 1
        val := json_value(depth + 1)
        if json_err != null { return null }
        obj[key] = val
        json_skip()
        if json_pos >= n {
            json_fail("unterminated object")
            return null
        }
        code := json_at(json_pos)
        if code == 44 {
            json_pos += 1
        } else if code == 125 {
            json_pos += 1
            return obj
        } else {
            json_fail("expected comma or closing brace in object")
            return null
        }
    }
}

json_value := (depth) {
    json_skip()
    if json_pos >= json_text.len {
        json_fail("unexpected end of input")
        return null
    }
    code := json_at(json_pos)
    if code == 123 { return json_object(depth) }
    if code == 91 { return json_array(depth) }
    if code == 34 { return json_string() }
    if code == 116 { return json_literal("true", true) }
    if code == 102 { return json_literal("false", false) }
    if code == 110 { return json_literal("null", null) }
    if code == 45 or json_is_digit(code) { return json_number() }
    json_fail("unexpected character")
    return null
}

json_parse := (text) {
    json_err = null
    if text == rune {
        text = string(text)
    }
    if text != string {
        json_err = "json: input must be a string"
        return null
    }
    json_text = text
    json_pos = 0
    result := json_value(0)
    if json_err == null {
        json_skip()
        if json_pos < json_text.len {
            json_fail("unexpected trailing characters")
        }
    }
    if json_err != null { return null }
    return result
}

json_parse_strict := (text) {
    result := json_parse(text)
    if json_err != null {
        panic(json_err)
    }
    return result
}

json_repeat := (s, count) {
    out := ""
    for (i := 0; i < count; i++) {
        out = out ~ s
    }
    return out
}

json_quote := (s) {
    hexd := "0123456789abcdef"
    out := ""
    out = out ~ rune(34)
    for (i := 0; i < s.len; i++) {
        c := s.char_at(i)
        code := i32(c)
        if code == 34 or code == 92 {
            out = out ~ rune(92) ~ c
        } else if code == 10 {
            out = out ~ rune(92) ~ "n"
        } else if code == 13 {
            out = out ~ rune(92) ~ "r"
        } else if code == 9 {
            out = out ~ rune(92) ~ "t"
        } else if code == 8 {
            out = out ~ rune(92) ~ "b"
        } else if code == 12 {
            out = out ~ rune(92) ~ "f"
        } else if code < 32 {
            out = out ~ rune(92) ~ "u00" ~ hexd.char_at(i32(code / 16)) ~ hexd.char_at(code % 16)
        } else {
            out = out ~ c
        }
    }
    out = out ~ rune(34)
    return out
}

json_encode := (v, pad, level) {
        if v == null {
        if string(v) == "null" { return "null" }
    }
    if v == bool {
        if v { return "true" }
        return "false"
    }
    if v == string { return json_quote(v) }
    if v == rune { return json_quote(string(v)) }
    if v == i32 { return string(v) }
    if v == f32 {
        if v - v != 0 { return "null" }
        return string(v)
    }

    is_obj := false
    has_items := false
    idx := 0
    for k, item in v {
        has_items = true
        if string(k) != string(idx) {
            is_obj = true
            break
        }
        idx += 1
    }
    if !has_items { return "[]" }

    open_code := 91
    close_code := 93
    if is_obj {
        open_code = 123
        close_code = 125
    }

    out := ""
    out = out ~ rune(open_code)
    is_first := true
    for k2, item2 in v {
        if !is_first { out = out ~ rune(44) }
        is_first = false
        if pad != "" { out = out ~ "\n" ~ json_repeat(pad, level + 1) }
        if is_obj {
            out = out ~ json_quote(string(k2)) ~ rune(58)
            if pad != "" { out = out ~ " " }
        }
        out = out ~ json_encode(item2, pad, level + 1)
    }
    if pad != "" { out = out ~ "\n" ~ json_repeat(pad, level) }
    out = out ~ rune(close_code)
    return out
}

json_stringify := (v) {
    return json_encode(v, "", 0)
}

json_pretty := (v, indent := 2) {
    pad := ""
    if (indent == string) {
        pad = indent
    } else {
        for (i := 0; i < indent; i++) {
            pad = pad ~ " "
        }
    }
    return json_encode(v, pad, 0)
}